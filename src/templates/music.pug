doctype html
html(lang="en")
  head
    include _head.pug
  body.music-page
    include _header.pug
    h1.music-title Music Page
    .player
      img(src=require('../images/thumbnail.jpg') alt="thumbnail")
      .text-container
        h2 Music name 
        h3 Artist name
        p Here is where the music player will go.
        audio#audio-player(controls preload="metadata")
        .controls 
          button#play-button Play
          button#pause-button Pause
          input#seek-bar(type="range" min="0" max="100" value="0")
          input#volume-bar(type="range" min="0" max="1" step="0.01" value="1")
      // 音楽プレーヤーの埋め込みコードやコンポーネントをここに追加
   
